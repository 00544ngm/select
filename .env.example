# Legacy provider bootstrap (optional)
# On web-backend startup these values are imported only when the matching
# provider has no saved database configuration. Manage later changes at
# http://localhost:3000/settings/api.

# GPT API
OPENAI_API_KEY=sk-your-key-here

# 可用模型（切换时取消注释对应的行）：
# gpt-5.6-terra  gpt-5.6-sol  gpt-5.6-luna  gpt-5.6
# gpt-5.5  gpt-5.5-pro  gpt-4o
OPENAI_MODEL=gpt-4o
OPENAI_MAX_TOKENS=16384
OPENAI_TEMPERATURE=0.3

# DeepSeek API
DEEPSEEK_API_KEY=sk-your-deepseek-key-here
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# CatToken API (OpenAI 兼容代理，提供 gpt-5.4/5.5/5.6 系列)
CATTOKEN_API_KEY=sk-your-cattoken-key-here
CATTOKEN_BASE_URL=https://www.cattoken.vip/v1
CATTOKEN_MODEL=gpt-5.4

# Browser
HEADLESS=false
BROWSER_WS_ENDPOINT=
CAPTCHA_WAIT_ENABLED=true
CAPTCHA_WAIT_TIMEOUT_SECONDS=600
CAPTCHA_CHECK_INTERVAL_SECONDS=5

# Timeout & retry
TIMEOUT_MS=30000
MAX_RETRIES=3

# Logging
LOG_LEVEL=INFO

# Web backend provider encryption
# Prefer leaving PROVIDER_ENCRYPTION_KEY empty for local use. The backend then
# creates backend/.api-config.key; back up that file with the PostgreSQL data.
PROVIDER_ENCRYPTION_KEY=
PROVIDER_KEY_FILE=backend/.api-config.key
